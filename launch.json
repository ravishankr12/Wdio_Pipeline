{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug WebdriverIO Test",
        "cwd":"${workspaceFolder}",
        "program": "${workspaceFolder}/node_modules/.bin/wdio",
        "autoAttachChildProcess":true,
        "args": ["wdio.local.conf.js", "--spec", "${file}"],
        
        "console": "integratedTerminal"
      }
    ]
  }
  